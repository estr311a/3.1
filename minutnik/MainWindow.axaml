<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="600"
        Width="420" Height="600"
        WindowStartupLocation="CenterScreen"
        x:Class="minutnik.MainWindow"
        Title="Minutnik Pomodoro">
    <Border Padding="20">
        <StackPanel Spacing="12">
            <!-- Stan sesji -->
            <TextBlock Name="StatusTextBlock"
                       Text="Stan: Praca"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <!-- Wyświetlacz czasu mm:ss -->
            <TextBlock Name="TimerTextBlock"
                       Text="25:00"
                       FontSize="50"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <!-- Ustawienia czasu pracy i przerwy -->
            <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                <StackPanel Spacing="4">
                    <TextBlock Text="Czas pracy (min):" HorizontalAlignment="Center" />
                    <TextBox Name="WorkMinutesTextBox" Text="25" Width="110" HorizontalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Czas przerwy (min):" HorizontalAlignment="Center" />
                    <TextBox Name="BreakMinutesTextBox" Text="5" Width="110" HorizontalContentAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Przyciski sterujące -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button Name="StartPauseButton"
                        Content="Start"
                        Width="110"
                        Height="36"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="StartPauseButton_Click" />
                <Button Name="ResetButton"
                        Content="Reset"
                        Width="110"
                        Height="36"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="ResetButton_Click" />
            </StackPanel>

            <!-- Licznik ukończonych cykli -->
            <TextBlock Name="CyclesTextBlock"
                       Text="Ukończone cykle: 0"
                       FontSize="16"
                       FontWeight="Medium"
                       HorizontalAlignment="Center" />

            <!-- Historia cykli -->
            <TextBlock Text="Historia cykli:" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListBox Name="HistoryList" Height="150" />
        </StackPanel>
    </Border>
</Window>
